{
  "expo": {
    "name": "Remerg",
    "slug": "remerg-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remerg",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.remerg.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserActivityTypes": [
          "INStartCallIntent"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#032256",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.remerg.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#032256",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#021638"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Remerg uses your location only when you ask for directions, to draw the route from where you are. It is not stored."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Colorado re-entry resources and crisis lines, available offline.",
    "primaryColor": "#032256"
  }
}
