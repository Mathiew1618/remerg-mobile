{
  "name": "Remerg Mobile (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "features": {
    // The base javascript-node image has no SSH daemon, which makes
    // `gh codespace ssh` and `gh codespace logs` fail. Without those there is
    // no way to read the creation log when setup goes wrong.
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },

  // Metro serves the web build and the Expo Go manifest on 8081. The 190xx
  // ports are Expo's legacy dev-server range; 8097 is React DevTools.
  "forwardPorts": [8081, 19000, 19001, 19006, 8097],
  "portsAttributes": {
    "8081": { "label": "Expo / Metro", "onAutoForward": "notify" },
    "19000": { "label": "Expo dev server" },
    "19001": { "label": "Expo dev server (alt)" },
    "19006": { "label": "Expo web (legacy)" },
    "8097": { "label": "React DevTools" }
  },

  // `npm ci` installs straight from the committed lockfile: faster than
  // `npm install` and it cannot silently resolve different versions.
  // updateContentCommand runs during prebuild/creation and, unlike
  // postCreateCommand, the terminal is not handed over until it finishes --
  // so you can't start typing before node_modules exists.
  "updateContentCommand": "npm ci",
  "waitFor": "updateContentCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "expo.vscode-expo-tools",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
